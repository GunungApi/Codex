  "captions": [
    {
      "start": 0.4343333333333333,
      "end": 4.281000000000001,
      "ja": "太陽が生まれる前から、\n五つの惑星が回っていた。",
      "en": "Five planets were already orbiting\nbefore the Sun was born.",
      "segment": 1,
      "groups": [
        0,
        2
      ]
    },
    {
      "start": 4.349,
      "end": 6.158333333333335,
      "ja": "ケプラー444。",
      "en": "Kepler-444.",
      "segment": 1,
      "groups": [
        2,
        4
      ]
    },
    {
      "start": 6.322333333333335,
      "end": 7.801000000000004,
      "ja": "どれほど古いんだろう。",
      "en": "How ancient is this system?",
      "segment": 1,
      "groups": [
        4,
        5
      ]
    },
    {
      "start": 8.626,
      "end": 12.664666666666667,
      "ja": "この星の年齢は、推定\nおよそ112億年。",
      "en": "Its star is estimated to be\nabout 11.2 billion years old.",
      "segment": 2,
      "groups": [
        0,
        3
      ]
    },
    {
      "start": 12.892666666666669,
      "end": 16.86733333333334,
      "ja": "太陽系のおよそ46億年と、\n比べてみよう。",
      "en": "Compare that with our Solar System:\nabout 4.6 billion years.",
      "segment": 2,
      "groups": [
        3,
        5
      ]
    },
    {
      "start": 17.667666666666666,
      "end": 19.455666666666666,
      "ja": "太陽が生まれた時点で、",
      "en": "When the Sun was born,",
      "segment": 3,
      "groups": [
        0,
        1
      ]
    },
    {
      "start": 19.56633333333333,
      "end": 22.87966666666667,
      "ja": "この星系は、\nすでにおよそ66億歳。",
      "en": "this system was already\nabout 6.6 billion years old.",
      "segment": 3,
      "groups": [
        1,
        3
      ]
    },
    {
      "start": 23.032999999999998,
      "end": 26.154333333333337,
      "ja": "地球の今の年齢よりも、\n長い時間だ。",
      "en": "Longer than Earth\nhas existed today.",
      "segment": 3,
      "groups": [
        3,
        5
      ]
    },
    {
      "start": 26.959333333333333,
      "end": 29.846,
      "ja": "惑星は五つとも、\n地球より小さい。",
      "en": "All five planets\nare smaller than Earth.",
      "segment": 4,
      "groups": [
        0,
        2
      ]
    },
    {
      "start": 29.988666666666663,
      "end": 32.406,
      "ja": "内側の一つは、\n水星ほど。",
      "en": "The innermost is\nabout the size of Mercury.",
      "segment": 4,
      "groups": [
        2,
        4
      ]
    },
    {
      "start": 32.48466666666667,
      "end": 35.403333333333336,
      "ja": "外側の一つも、\n金星より小さい。",
      "en": "Even the outermost\nis smaller than Venus.",
      "segment": 4,
      "groups": [
        4,
        6
      ]
    },
    {
      "start": 36.20933333333333,
      "end": 37.784,
      "ja": "しかも、五つとも、",
      "en": "And all five",
      "segment": 5,
      "groups": [
        0,
        2
      ]
    },
    {
      "start": 37.788000000000004,
      "end": 39.98133333333334,
      "ja": "10日もかからず\n星を一周する。",
      "en": "complete an orbit\nin less than ten days.",
      "segment": 5,
      "groups": [
        2,
        3
      ]
    },
    {
      "start": 40.08133333333333,
      "end": 43.72533333333334,
      "ja": "星のすぐ近くに、\nぎゅっと集まった惑星系だ。",
      "en": "A tightly packed system,\nvery close to its star.",
      "segment": 5,
      "groups": [
        3,
        5
      ]
    },
    {
      "start": 44.54266666666667,
      "end": 45.776,
      "ja": "若い宇宙にも、",
      "en": "Even in the young universe,",
      "segment": 6,
      "groups": [
        0,
        1
      ]
    },
    {
      "start": 45.854666666666674,
      "end": 48.34666666666667,
      "ja": "小さな惑星の世界は\n育っていた。",
      "en": "worlds with small planets\nwere already forming.",
      "segment": 6,
      "groups": [
        1,
        2
      ]
    },
    {
      "start": 48.414666666666676,
      "end": 50.864000000000004,
      "ja": "太陽系は、\nその長い歴史の、",
      "en": "Our Solar System",
      "segment": 6,
      "groups": [
        2,
        4
      ]
    },
    {
      "start": 51.14533333333334,
      "end": 53.09333333333334,
      "ja": "ずっと後から登場したんだ。",
      "en": "arrived much later\nin that long history.",
      "segment": 6,
      "groups": [
        4,
        5
      ]
    }
  ],
  "narration": [
    {
      "id": 1,
      "file": "01.wav",
      "start": 0.35,
      "end": 7.891333333333333,
      "duration": 7.541333333333333,
      "text": "太陽が生まれる前から、五つの惑星が回っていた。ケプラー、よんよんよん。どれほど古いんだろう。",
      "groups": [
        {
          "start": 0.14933333333333335,
          "end": 1.6853333333333331,
          "kana": "タイヨウガウマレルマエカラ"
        },
        {
          "start": 1.9733333333333332,
          "end": 3.7760000000000007,
          "kana": "イツツノワクセイガマワッテイタ"
        },
        {
          "start": 4.064000000000001,
          "end": 4.597333333333335,
          "kana": "ケプラア"
        },
        {
          "start": 5.024000000000002,
          "end": 5.653333333333335,
          "kana": "ヨンヨンヨン"
        },
        {
          "start": 6.037333333333335,
          "end": 7.296000000000004,
          "kana": "ドレホドフルインダロオ"
        }
      ],
      "kana": "タ'イヨウガ/ウマレル'/マ'エカラ、イツ'ツノ/ワ_クセイガ'/マワッテ'/イタ'、ケ'プラア、ヨンヨ'ンヨン、ドレホド'/フル'イ/ン'ダロオ"
    },
    {
      "id": 2,
      "file": "02.wav",
      "start": 8.541666666666666,
      "end": 16.957666666666668,
      "duration": 8.416,
      "text": "この星の年齢は、推定、およそ百十二億年。太陽系のおよそ四十六億年と、比べてみよう。",
      "groups": [
        {
          "start": 0.14933333333333335,
          "end": 1.3866666666666667,
          "kana": "コノホシノネンレイワ"
        },
        {
          "start": 1.6853333333333333,
          "end": 2.2293333333333334,
          "kana": "スイテエ"
        },
        {
          "start": 2.5493333333333332,
          "end": 3.9680000000000013,
          "kana": "オヨソヒャクジュウニオクネン"
        },
        {
          "start": 4.416000000000001,
          "end": 6.890666666666673,
          "kana": "タイヨウケイノオヨソヨンジュウロクオクネント"
        },
        {
          "start": 7.274666666666674,
          "end": 8.170666666666675,
          "kana": "クラベテミヨオ"
        }
      ],
      "kana": "コノ'/ホシノ'/ネンレイワ'、スイテエ'、オヨソ'/ヒャ'クジュウ/ニオク'ネン、タイヨウケイノ'/オヨソ'/ヨ'ンジュウ/ロクオク'ネント、クラベテ'/ミ'ヨオ"
    },
    {
      "id": 3,
      "file": "03.wav",
      "start": 17.583333333333332,
      "end": 26.244666666666667,
      "duration": 8.661333333333333,
      "text": "太陽が生まれた時点で、この星系は、すでにおよそ六十六億歳。地球の今の年齢よりも、長い時間だ。",
      "groups": [
        {
          "start": 0.14933333333333335,
          "end": 1.717333333333333,
          "kana": "タイヨウガウマレタジテンデ"
        },
        {
          "start": 2.0479999999999996,
